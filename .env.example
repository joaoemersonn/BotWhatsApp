# Configurações do Ambiente
NODE_ENV=development

# Informações do Bot
BOT_NAME="Meu Bot WhatsApp"
BOT_PREFIX="!"

# Diretório para persistência da sessão do WhatsApp (Multi-device)
# No Docker, este caminho é montado como volume persistente
AUTH_DIR="./auth_info_baileys"

# Nível de log (trace, debug, info, warn, error, silent)
LOG_LEVEL="info"

# Comportamento de Mensagens
AUTO_READ_MESSAGES=true
IGNORE_GROUPS=false

# (Opcional) Conexão via Código de Pareamento (Pairing Code)
# Se você preencher o número com DDI e DDD (ex: 5511999999999), o bot gerará um código
# de 8 dígitos para você digitar no WhatsApp em vez de escanear o QR Code.
# Deixe em branco se preferir o QR Code normal.
PAIRING_NUMBER=

# ==========================================
# Configurações da API HTTP (Disparo Ativo)
# ==========================================
# Porta onde a API HTTP ficará escutando requisições
PORT=3000

# Chave de autenticação para a API (Header: "x-api-key" ou "Authorization: Bearer <API_KEY>")
# Se definida, todas as requisições para a API precisarão deste token.
# Deixe em branco se não quiser autenticação por token.
API_KEY="seu_token_secreto_super_seguro_aqui"
